# ──────────────────────────────────────────
# Sell Marketplace — Environment Variables
# ──────────────────────────────────────────

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://sell_user:sell_pass@localhost:5432/sell_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sell_db
DATABASE_USER=sell_user
DATABASE_PASSWORD=sell_pass

# Redis (Caching / Sessions / Pub-Sub)
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# API Server
API_PORT=4000
API_URL=http://localhost:4000

# Next.js Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_NAME=Sell
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Media / CDN (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AWS (S3 + Rekognition)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=sell-media

# Search Engine (Typesense)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=
TYPESENSE_PROTOCOL=http

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# SMS / OTP (Twilio or similar)
SMS_API_KEY=
SMS_SENDER_ID=SELL

# Google Maps / Places
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

